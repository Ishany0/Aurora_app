# This file contains placeholders only.
# Never commit real .env files.
# Firebase web config is public client configuration; access is secured by Firebase rules.
# Do not add GEMINI_API_KEY or any server-only secret to VITE_ variables.

# Frontend-safe Firebase configuration
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Backend-only secrets
GEMINI_API_KEY=replace_with_secret_manager_in_production
GOOGLE_MAPS_SERVER_API_KEY=optional_server_side_key_only

